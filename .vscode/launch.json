{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Express",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "src/index.ts"],
      "program": "${workspaceFolder}/src/index.ts",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}
